
(2309livewire) {
    php_fastcgi 2309livewire:9000
    root * /home/2309livewire/public
}

(base) {

    @storage path_regexp ^/storage/.*\.php$
        respond @storage 403 "Forbidden probe path"

    # Формируем самоподписной сертификат для работы https
    file_server
    encode gzip
}

(tls1) {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            email support@php-cat.com
        }

    }
}

(tls11) {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            email support@php-cat.com
        }
        # Отключение OCSP stapling
        ocsp_stapling off
    }
}

(tls_off) {
    tls internal
}

(tls2) {
    tls {
        issuer acme {
            dir https://acme.zerossl.com/v2/DV90
            email 2@php-cat.com
        }
    }
}

